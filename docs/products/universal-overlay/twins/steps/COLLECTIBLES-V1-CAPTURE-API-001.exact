/**
 * SYNOPSIS: Collectibles capture + Vault list/dossier routes.
 * @ssot docs/products/collectibles/PRODUCT_HOME.md
 */
import crypto from 'node:crypto';
import { createCollectibleTwin } from '../services/collectibles/twin-service.js';
import { createMtgCategoryAdapter } from '../services/collectibles/adapters/mtg-adapter.js';
import { createCollectibleTwinStore } from '../services/collectibles/twin-store.js';
import { createMediaEvidenceStore } from '../services/collectibles/media-evidence.js';

function noopLogger() {
  return { info() {}, warn() {}, error() {}, debug() {} };
}

function confidenceOf(identity) {
  const n = Number(identity?.confidence ?? identity?.identify_confidence);
  if (Number.isFinite(n)) return n;
  if (identity?.scryfall_id || identity?.name) return 0.7;
  return 0;
}

function mapTwinForStore(twin, ownerUserId) {
  return {
    twinId: twin.id,
    productId: twin.category_id || 'mtg',
    serialNumber: twin.display_name || twin.id,
    status: twin.identity_status || 'owned_unverified',
    ownerId: ownerUserId || twin.owner_user_id || null,
    custodianId: null,
    locationId: null,
    createdBy: String(ownerUserId || twin.owner_user_id || 'system'),
    updatedBy: String(ownerUserId || twin.owner_user_id || 'system'),
  };
}

/**
 * Register Collectibles API routes under /api/v1/collectibles.
 * @param {import('express').Application} app
 * @param {object} deps
 */
export function registerCollectiblesRoutes(app, deps = {}) {
  const auth = typeof deps.requireAuth === 'function' ? deps.requireAuth : (_req, _res, next) => next();
  const adapter = createMtgCategoryAdapter();
  const logger = deps.logger || noopLogger();
  const twinStore = deps.twinStore
    || (deps.pool ? createCollectibleTwinStore({ pool: deps.pool, logger }) : null);
  const mediaStore = deps.mediaStore
    || (deps.pool ? createMediaEvidenceStore({ pool: deps.pool, logger }) : null);

  app.post('/api/v1/collectibles', auth, async (req, res) => {
    try {
      const twin = createCollectibleTwin({
        ...(req.body || {}),
        category_id: (req.body && req.body.category_id) || 'mtg',
        adapter_id: (req.body && req.body.adapter_id) || 'mtg_v1',
        owner_user_id: req.user?.id || req.body?.owner_user_id || null,
      });
      res.status(201).json({ ok: true, twin, adapter_category: adapter.identify('__CATEGORY_ID_TEST_STRING__') });
    } catch (err) {
      res.status(400).json({ ok: false, error: err.message });
    }
  });

  app.get('/api/v1/collectibles', auth, async (req, res) => {
    res.json({
      ok: true,
      twins: [],
      needs_review: req.query?.needs_review === 'true',
      note: 'legacy list — prefer GET /api/v1/collectibles/twins',
    });
  });

  app.post('/api/v1/collectibles/twins/capture', auth, async (req, res) => {
    try {
      if (!twinStore || !mediaStore) {
        return res.status(503).json({
          ok: false,
          error_code: 'STORE_UNAVAILABLE',
          message: 'twinStore/mediaStore require pool',
        });
      }
      const ownerUserId = req.user?.id || req.body?.owner_user_id || null;
      const batch_id = crypto.randomUUID();
      const importRows = Array.isArray(req.body?.import_rows) ? req.body.import_rows : [];
      const files = Array.isArray(req.body?.files) ? req.body.files : [];
      const rows = importRows.length
        ? importRows
        : (files.length ? files : [{ ...(req.body || {}) }]);
      const twins = [];
      let needs_review_count = 0;

      for (const row of rows) {
        let identity = null;
        let identifyFailed = false;
        try {
          identity = await Promise.resolve(adapter.identify(row?.photo || row?.image || row));
        } catch {
          identifyFailed = true;
          identity = null;
        }
        const conf = confidenceOf(identity);
        const needs_review = identifyFailed || conf < 0.55 || !adapter.resolveIdentity?.(identity);
        if (needs_review) needs_review_count += 1;

        const twin = createCollectibleTwin({
          owner_user_id: ownerUserId,
          household_id: req.body?.household_id || row?.household_id || null,
          category_id: 'mtg',
          adapter_id: 'mtg_v1',
          representation_level: 1,
          identity_status: identifyFailed || !identity?.name ? 'owned_unverified' : 'owned_canonical',
          needs_review,
          needs_review_reasons: needs_review
            ? [identifyFailed ? 'identify_failed' : 'low_confidence_or_unresolved']
            : [],
          display_name: identity?.name || row?.display_name || row?.name || 'Unidentified collectible',
        });

        const stored = await twinStore.insertTwin(mapTwinForStore(twin, ownerUserId));
        const twinId = stored?.twin_id || stored?.twinId || twin.id;

        const mediaB64 = row?.photo_base64 || row?.image_base64 || null;
        if (mediaB64) {
          const buf = Buffer.from(String(mediaB64).replace(/^data:[^;]+;base64,/, ''), 'base64');
          const sha256 = crypto.createHash('sha256').update(buf).digest('hex');
          await mediaStore.persistMedia(
            twinId,
            row?.mime_type || 'image/jpeg',
            row?.filename || `${twinId}.jpg`,
            sha256,
            buf,
          );
        }

        twins.push({
          ...twin,
          id: twinId,
          liquidity_posture: 'surprise_me',
          auto_listed: false,
        });
      }

      res.status(201).json({ ok: true, batch_id, twins, needs_review_count });
    } catch (err) {
      logger.error?.({ err: err.message }, 'collectibles twins/capture failed');
      res.status(400).json({ ok: false, error_code: 'CAPTURE_FAILED', message: err.message });
    }
  });

  app.get('/api/v1/collectibles/twins', auth, async (req, res) => {
    try {
      if (!twinStore) {
        return res.status(503).json({ ok: false, error_code: 'STORE_UNAVAILABLE', message: 'twinStore require pool' });
      }
      const ownerId = req.user?.id || req.query?.owner_user_id || null;
      const listed = await twinStore.listTwins({
        ownerId: ownerId || undefined,
        productId: req.query?.category_id || undefined,
        limit: Number(req.query?.limit) || 50,
        offset: Number(req.query?.offset) || 0,
      });
      const needsOnly = req.query?.needs_review === 'true';
      const twins = (listed || [])
        .map((row) => ({
          id: row.twin_id || row.twinId,
          display_name: row.serial_number || row.display_name || row.twin_id,
          category_id: row.product_id || row.category_id,
          needs_review: Boolean(row.needs_review),
          hero_media_url: null,
          price_range: null,
        }))
        .filter((t) => (needsOnly ? t.needs_review : true));
      res.json({ ok: true, twins, needs_review: needsOnly });
    } catch (err) {
      res.status(400).json({ ok: false, error_code: 'LIST_FAILED', message: err.message });
    }
  });

  app.get('/api/v1/collectibles/twins/:id', auth, async (req, res) => {
    try {
      if (!twinStore) {
        return res.status(503).json({ ok: false, error_code: 'STORE_UNAVAILABLE', message: 'twinStore require pool' });
      }
      const twin = await twinStore.getTwin(req.params.id);
      if (!twin) {
        return res.status(404).json({ ok: false, error_code: 'NOT_FOUND', message: 'twin not found' });
      }
      res.json({
        ok: true,
        twin: {
          id: twin.twin_id || twin.twinId,
          display_name: twin.serial_number || twin.display_name,
          identity_status: twin.status,
          needs_review: Boolean(twin.needs_review),
          ownership: twin.owner_id || twin.ownerId || null,
          possession: null,
          custody: twin.custodian_id || twin.custodianId || null,
          location: twin.location_id || twin.locationId || null,
          liquidity_posture: 'surprise_me',
        },
      });
    } catch (err) {
      res.status(400).json({ ok: false, error_code: 'GET_FAILED', message: err.message });
    }
  });
}
